        "jsCode": "const rows = items.map(item => item.json);\n\nif (rows.length === 0) {\n  return [\n    {\n      json: {\n        digest_text: \"🤖 <b>No daily digest is available yet.</b>\\n\\nCheck back after the next daily update.\"\n      }\n    }\n  ];\n}\n\nrows.sort((a, b) => {\n  const dateA = new Date(a.sent_at || a.date || 0);\n  const dateB = new Date(b.sent_at || b.date || 0);\n\n  return dateB - dateA;\n});\n\nreturn [\n  {\n    json: rows[0]\n  }\n];"
      },
