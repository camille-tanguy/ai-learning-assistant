      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        64,
        -128
      ],
      "id": "fbd79f2f-fec6-4cf8-b341-a493b9c19e41",
      "name": "Load Existing Articles",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// All fresh articles coming from BOTH sources\nconst articles = $('Merge').all().map(item => item.json);\n\n// Articles already saved in Google Sheets\nconst existingArticles = items.map(item => item.json);\n\n\n// ---------- Helper: extract arXiv ID ----------\nfunction getArxivId(article) {\n  if (article.arxiv_id) {\n    return String(article.arxiv_id).replace(/v\\d+$/, \"\");\n  }\n\n  const url = article.original_url || article.url || \"\";\n\n  const match = url.match(/arxiv\\.org\\/abs\\/([^/?#]+)/);\n\n  if (match) {\n    return match[1].replace(/v\\d+$/, \"\");\n  }\n\n  return \"\";\n}\n\n\n// ---------- 1. Build set of articles already stored ----------\nconst existingIds = new Set(\n  existingArticles\n    .map(article => getArxivId(article))\n    .filter(Boolean)\n);\n\n\n// ---------- 2. Deduplicate + enrich current sources ----------\nconst byArxivId = new Map();\n\nfor (const article of articles) {\n\n  const arxivId = getArxivId(article);\n\n  // Fallback if somehow no arXiv ID exists\n  const key = arxivId || article.url;\n\n  if (!key) continue;\n\n\n  // First time we see this paper\n  if (!byArxivId.has(key)) {\n    byArxivId.set(key, {\n      ...article,\n      arxiv_id: arxivId\n    });\n\n    continue;\n  }\n\n\n  // Same paper found from another source\n  const existing = byArxivId.get(key);\n\n  const currentIsHF =\n    article.source === \"Hugging Face Daily Papers\";\n\n  const existingIsHF =\n    existing.source === \"Hugging Face Daily Papers\";\n\n\n  // Combine the information from both sources\n  const enriched = {\n    ...existing,\n\n    arxiv_id: arxivId || existing.arxiv_id,\n\n    // Prefer non-empty title/content\n    title: existing.title || article.title || \"\",\n\n    description:\n      existing.description?.length >= article.description?.length\n        ? existing.description\n        : article.description,\n\n    content:\n      existing.content?.length >= article.content?.length\n        ? existing.content\n        : article.content,\n\n    // Always keep original arXiv page\n    original_url:\n      existing.original_url ||\n      article.original_url ||\n      `https://arxiv.org/abs/${arxivId}`,\n\n    // If HF has the paper, prefer HF for Quick Read\n    quick_read_url:\n      currentIsHF\n        ? article.quick_read_url\n        : existingIsHF\n          ? existing.quick_read_url\n          : existing.quick_read_url || article.quick_read_url,\n\n    featured_on_huggingface:\n      existing.featured_on_huggingface === true ||\n      article.featured_on_huggingface === true,\n\n    // Show that the record came from both sources\n    source:\n      existing.source === article.source\n        ? existing.source\n        : \"arXiv + Hugging Face\"\n  };\n\n  byArxivId.set(key, enriched);\n}\n\n\n// ---------- 3. Remove articles already stored in Sheets ----------\nconst newArticles = [...byArxivId.values()].filter(article => {\n\n  const arxivId = getArxivId(article);\n\n  return !arxivId || !existingIds.has(arxivId);\n});\n\n\n// ---------- 4. Return to n8n ----------\nreturn newArticles.map(article => ({\n  json: article\n}));"
      },
