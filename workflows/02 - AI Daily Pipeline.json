    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const article = $json;\n\nconst text = `${article.title || \"\"} ${article.description || \"\"}`.toLowerCase();\n\nconst keywords = [\n  \"artificial intelligence\",\n  \"machine learning\",\n  \"deep learning\",\n  \"large language model\",\n  \"llm\",\n  \"agent\",\n  \"computer vision\",\n  \"neural network\",\n  \"transformer\",\n  \"reinforcement learning\",\n  \"generative ai\",\n  \"foundation model\",\n  \"multimodal\",\n  \"reasoning\",\n  \"robotics\"\n];\n\nconst matchedKeywords = keywords.filter(keyword =>\n  text.includes(keyword)\n);\n\nreturn {\n  json: {\n    ...article,\n    keyword_matches: matchedKeywords,\n    keyword_match_count: matchedKeywords.length,\n    deterministic_relevant: matchedKeywords.length > 0\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        -112
      ],
      "id": "b85043da-9993-4a6b-b61e-0274e8eba35e",
      "name": "Keyword Relevance Filter"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "ARTICLES"
        },
        "filtersUI": {
          "values": []
        },
        "options": {}
