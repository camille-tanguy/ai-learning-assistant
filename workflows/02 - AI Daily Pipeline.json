      "id": "853be28b-3336-4c1c-b5d0-6739c227fa5a",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const scored = items.map(item => {\n  const article = item.json;\n\n  const keywordScore = article.keyword_match_count || 0;\n\n  const textLength =\n    (article.title || \"\").length +\n    (article.description || \"\").length;\n\n  const lengthBonus = textLength > 800 ? 1 : 0;\n\n  const deterministic_score =\n    keywordScore * 2 +\n    lengthBonus;\n\n  return {\n    json: {\n      ...article,\n      deterministic_score\n    }\n  };\n});\n\nscored.sort((a, b) =>\n  b.json.deterministic_score - a.json.deterministic_score\n);\n\nreturn scored.slice(0, 30);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -128
      ],
      "id": "cc31a140-bfce-46c7-8a3d-a0e4f07ed02a",
      "name": "Deterministic Ranking"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        784,
        -128
      ],
      "id": "1b0daed4-18c3-4e2d-8bed-24293365fb89",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "amount": 2
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        64
      ],
      "id": "fa6fc9e4-42c4-489d-b12a-0f6aea7f4fbc",
      "name": "Wait"
    },
    {
      "parameters": {
        "jsCode": "const ranked = items\n  .filter(item => item.json.valid_json === true)\n  .map(item => {\n    const article = item.json;\n\n    const final_score =\n      (article.relevance_score || 0) * 0.4 +\n      (article.learning_score || 0) * 0.35 +\n      (article.novelty_score || 0) * 0.25;\n\n    return {\n      json: {\n        ...article,\n\n        article_id: article.arxiv_id\n          ? `A-${article.arxiv_id}`\n          : article.article_id || \"\",\n\n        final_score\n      }\n    };\n  });\n\nranked.sort((a, b) =>\n  b.json.final_score - a.json.final_score\n);\n\nreturn ranked.slice(0, 5);"
      },
