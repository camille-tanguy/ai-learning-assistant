    {
      "parameters": {
        "jsCode": "const articles = items[0].json.rss.channel.item || [];\n\nreturn articles.map(article => {\n  const rawUrl = article.link || \"\";\n\n  const arxivId = rawUrl\n    .replace(\"https://arxiv.org/abs/\", \"\")\n    .replace(\"http://arxiv.org/abs/\", \"\")\n    .split(\"v\")[0];\n\n  return {\n    json: {\n      article_id: null,\n\n      arxiv_id: arxivId,\n\n      title: article.title || \"\",\n\n      url: rawUrl,\n\n      original_url: rawUrl,\n\n      quick_read_url: arxivId\n        ? `https://ar5iv.labs.arxiv.org/html/${arxivId}`\n        : rawUrl,\n\n      source: \"arXiv cs.AI\",\n\n      published_at: article.pubDate || \"\",\n\n      description: article.description || \"\",\n      content: article.description || \"\",\n\n      featured_on_huggingface: false,\n\n      category: null,\n      relevance_score: null,\n      learning_score: null,\n      novelty_score: null,\n      summary: null,\n\n      processed: false\n    }\n  };\n});"
      },
