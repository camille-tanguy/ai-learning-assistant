    {
      "parameters": {
        "jsCode": "function escapeHtml(text = \"\") {\n  return String(text)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\");\n}\n\nconst articles = items.map((item, index) => {\n  const a = item.json;\n\n  const date = a.published_at\n    ? new Date(a.published_at).toLocaleDateString(\"en-GB\", {\n        day: \"numeric\",\n        month: \"short\",\n        year: \"numeric\"\n      })\n    : \"Unknown date\";\n\n  const featured = a.featured_on_huggingface\n    ? \"\\n🔥 Featured on Hugging Face Daily Papers\"\n    : \"\";\n\n  return `${index + 1}️⃣ <b>${escapeHtml(a.title)}</b>\n\n🧭 ${escapeHtml(a.category)} · 📅 ${date}${featured}\n\n🔎 <b>What it does</b>\n${escapeHtml(a.what_it_does)}\n\n💡 <b>Why you should care</b>\n${escapeHtml(a.why_it_matters)}\n\n⭐ Relevance ${a.relevance_score} · Learning ${a.learning_score} · Novelty ${a.novelty_score}\n\n👉 <b>Want to dive deeper?</b>\n<a href=\"${a.quick_read_url}\">Quick read</a> · <a href=\"${a.original_url}\">Original paper</a>`;\n});\n\nconst articleIds = items\n  .map(item => item.json.article_id)\n  .filter(Boolean);\n\nconst best = items[0]?.json;\n\nconst digest = `🤖 <b>AI Daily Digest</b>\n\nToday’s Top ${items.length} AI papers worth your attention:\n\n${articles.join(\"\\n\\n────────────\\n\\n\")}\n\n🏆 <b>Start with #1</b>\n${best ? `Best overall balance today: ${escapeHtml(best.title)}` : \"\"}`;\n\nreturn [\n  {\n    json: {\n      digest_text: digest,\n      article_count: items.length,\n      article_ids: articleIds.join(\",\"),\n      generated_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        -192
      ],
      "id": "a5fb1ace-0a9a-4b0e-be66-fea16f488c13",
      "name": "Format Daily Digest",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const validItems = items.filter(item => {\n  const p = item.json.paper;\n\n  return (\n    p &&\n    p.id &&\n    p.title\n  );\n});\n\nreturn validItems.map(item => {\n  const p = item.json.paper;\n\n  const arxivId = p.id;\n\n  const summary =\n    p.summary ||\n    p.abstract ||\n    item.json.summary ||\n    \"\";\n\n  return {\n    json: {\n      article_id: null,\n\n      arxiv_id: arxivId,\n\n      title: p.title,\n\n      url: `https://huggingface.co/papers/${arxivId}`,\n\n      original_url: `https://arxiv.org/abs/${arxivId}`,\n\n      quick_read_url: `https://huggingface.co/papers/${arxivId}`,\n\n      source: \"Hugging Face Daily Papers\",\n\n      published_at:\n        p.publishedAt ||\n        item.json.publishedAt ||\n        \"\",\n\n      description: summary,\n      content: summary,\n\n      authors: Array.isArray(p.authors)\n        ? p.authors.map(a => a.name).filter(Boolean)\n        : [],\n\n      featured_on_huggingface: true,\n\n      category: null,\n      relevance_score: null,\n      learning_score: null,\n      novelty_score: null,\n      summary: null,\n\n      processed: false\n    }\n  };\n});"
      },
